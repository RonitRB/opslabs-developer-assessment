# YouTube Data API v3 (Task 2)
YOUTUBE_API_KEY=

# Task 1 LLM (use Make.com managed connections for deployed scenarios)
LLM_PROVIDER=groq
GROQ_API_KEY=
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DOCS_FOLDER_ID=

# Optional Google Sheets append (Task 2)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Videos

# Task 3 webhook / Slack delivery
WEBHOOK_SECRET=replace-with-a-long-random-secret
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
HOST=127.0.0.1
PORT=8000

# Optional shared application settings
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=4

# Make.com credentials are stored as Make connections, not here.
